<?xml version="1.0" encoding="utf-8"?>
<!-- headqlink: Material 3 oscuro con el acento «Eléctrico» (en el coche se ve mejor y no deslumbra de noche) (en el coche se ve mejor y no deslumbra de noche). La pantalla de
     inicio de Android 12+ está en values-v31. -->
<resources>
    <style name="Base.Theme.HeadQLink" parent="Theme.Material3.Dark.NoActionBar">
        <item name="android:windowBackground">@drawable/hql_window_bg</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:statusBarColor">@color/hql_bg</item>
        <item name="android:navigationBarColor">@color/hql_bg</item>
        <item name="android:colorBackground">@color/hql_bg</item>
        <item name="colorOnBackground">@color/hql_text</item>

        <item name="colorPrimary">@color/hql_accent</item>
        <item name="colorOnPrimary">@color/hql_on_accent</item>
        <item name="colorPrimaryContainer">@color/hql_accent_container</item>
        <item name="colorOnPrimaryContainer">@color/hql_accent</item>
        <item name="colorSecondary">@color/hql_accent_2</item>
        <item name="colorOnSecondary">@color/hql_on_accent</item>
        <item name="colorSecondaryContainer">@color/hql_accent_container</item>
        <item name="colorOnSecondaryContainer">@color/hql_accent_2</item>
        <item name="colorTertiary">@color/hql_accent_2</item>
        <item name="colorError">@color/hql_error</item>
        <item name="colorOnError">@color/hql_on_error</item>

        <item name="colorSurface">@color/hql_surface</item>
        <item name="colorOnSurface">@color/hql_text</item>
        <item name="colorSurfaceVariant">@color/hql_surface_top</item>
        <item name="colorOnSurfaceVariant">@color/hql_text_dim</item>
        <item name="colorSurfaceContainerLowest">@color/hql_bg</item>
        <item name="colorSurfaceContainerLow">@color/hql_surface</item>
        <item name="colorSurfaceContainer">@color/hql_surface</item>
        <item name="colorSurfaceContainerHigh">@color/hql_surface_hi</item>
        <item name="colorSurfaceContainerHighest">@color/hql_surface_top</item>
        <item name="colorOutline">@color/hql_idle</item>
        <item name="colorOutlineVariant">@color/hql_outline</item>

        <!-- Casillas, botones de opción y campos de texto (vistas del sistema en los diálogos) -->
        <item name="colorAccent">@color/hql_accent</item>
        <item name="colorControlNormal">@color/hql_text_dim</item>
        <item name="colorControlActivated">@color/hql_accent</item>
        <item name="colorControlHighlight">@color/hql_ripple</item>
        <item name="android:colorControlNormal">@color/hql_text_dim</item>
        <item name="android:colorControlActivated">@color/hql_accent</item>
        <item name="android:colorControlHighlight">@color/hql_ripple</item>
        <item name="android:textColorPrimary">@color/hql_text</item>
        <item name="android:textColorSecondary">@color/hql_text_dim</item>
        <item name="android:textColorHint">@color/hql_text_faint</item>
        <item name="android:textColorHighlight">#5500E5C7</item>

        <item name="materialButtonStyle">@style/HQL.Button</item>
        <item name="materialAlertDialogTheme">@style/HQL.Dialog</item>

    </style>

    <style name="Theme.HeadQLink" parent="Base.Theme.HeadQLink" />

    <!-- ============================================================ diálogos -->

    <style name="HQL.Dialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="colorSurface">@color/hql_surface_hi</item>
        <item name="colorSurfaceContainerHigh">@color/hql_surface_hi</item>
        <item name="colorPrimary">@color/hql_accent</item>
        <item name="colorOnSurface">@color/hql_text</item>
        <item name="colorOnSurfaceVariant">@color/hql_text_dim</item>
        <item name="alertDialogStyle">@style/HQL.AlertDialog</item>
        <item name="materialAlertDialogTitleTextStyle">@style/HQL.AlertDialog.Title</item>
        <item name="buttonBarPositiveButtonStyle">@style/HQL.AlertDialog.Button</item>
        <item name="buttonBarNeutralButtonStyle">@style/HQL.AlertDialog.Button</item>
        <item name="buttonBarNegativeButtonStyle">@style/HQL.AlertDialog.Button.Dim</item>
    </style>

    <style name="HQL.AlertDialog" parent="MaterialAlertDialog.Material3">
        <item name="backgroundTint">@color/hql_surface_hi</item>
        <item name="shapeAppearance">@style/HQL.ShapeDialog</item>
    </style>

    <style name="HQL.ShapeDialog" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">24dp</item>
    </style>

    <style name="HQL.AlertDialog.Title" parent="MaterialAlertDialog.Material3.Title.Text">
        <item name="android:textColor">@color/hql_text</item>
    </style>

    <style name="HQL.AlertDialog.Button" parent="Widget.Material3.Button.TextButton.Dialog">
        <item name="android:textColor">@color/hql_accent</item>
        <item name="android:minHeight">48dp</item>
        <item name="rippleColor">@color/hql_ripple</item>
    </style>

    <style name="HQL.AlertDialog.Button.Dim">
        <item name="android:textColor">@color/hql_text_dim</item>
    </style>



    <!-- ============================================================ botones -->

    <!-- Principal (CONECTAR, Continuar, Exportar…): degradado cian → verde. Activado (setActivated) = Desconectar. -->
    <!-- Principal (Conectar, Continuar, Exportar…): botón relleno de Material 3 en el acento. Activado (setActivated) =
         Desconectar, en el contenedor de error. Alto: se toca bien con el móvil en el soporte. -->
    <style name="HQL.Button" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/hql_btn_fill</item>
        <item name="android:textColor">@color/hql_btn_primary_text</item>
        <item name="android:textAppearance">?attr/textAppearanceTitleMedium</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:paddingStart">24dp</item>
        <item name="android:paddingEnd">24dp</item>
    </style>

    <style name="HQL.Button.Quiet" parent="Widget.Material3.Button.TextButton">
        <item name="android:minHeight">48dp</item>
        <item name="android:textColor">@color/hql_accent</item>
        <item name="rippleColor">@color/hql_ripple</item>
    </style>

    <style name="HQL.Button.Outline" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minHeight">48dp</item>
        <item name="android:textColor">@color/hql_accent</item>
        <item name="rippleColor">@color/hql_ripple</item>
    </style>

    <!-- ============================================================ texto -->

    <style name="HQL" />

    <style name="HQL.Text" />

    <!-- Títulos grandes y legibles con el móvil a un brazo de distancia -->
    <style name="HQL.Text.Title" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="android:textColor">@color/hql_text</item>
    </style>

    <style name="HQL.Text.Title.Display" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:textColor">@color/hql_text</item>
    </style>

    <style name="HQL.Text.Body" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:textColor">@color/hql_text_dim</item>
    </style>

    <!-- Etiquetas de sección: condensadas, en mayúsculas y espaciadas -->
    <style name="HQL.Text.Label" parent="TextAppearance.Material3.TitleSmall">
        <item name="android:textColor">@color/hql_text_dim</item>
    </style>

    <style name="HQL.Text.Label.Accent" parent="TextAppearance.Material3.TitleSmall">
        <item name="android:textColor">@color/hql_accent</item>
    </style>

    <style name="HQL.Text.Brand">
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/hql_text</item>
        <item name="android:letterSpacing">0.2</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:fontFamily">sans-serif-condensed</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="HQL.Text.RowTitle" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textColor">@color/hql_text</item>
    </style>

    <style name="HQL.Text.RowDetail" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textColor">@color/hql_text_dim</item>
    </style>

    <!-- Nombre de una fila de estado (COCHE, RED…) -->
    <style name="HQL.Text.RowLabel" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:textColor">@color/hql_text_dim</item>
    </style>

    <!-- Cifras del panel en directo (fps, Mbps) -->
    <style name="HQL.Text.Meter" parent="TextAppearance.Material3.DisplaySmall">
        <item name="android:textColor">@color/hql_text</item>
        <item name="android:fontFeatureSettings">tnum</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="HQL.Text.Unit" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:textColor">@color/hql_accent</item>
    </style>

    <!-- Chip de estado: lo colorea Ui.chip (verde, ámbar, rojo o gris, con su icono) -->
    <!-- Chip de estado (como un chip de ayuda de Material 3): lo colorea Ui.chip (verde, ámbar, rojo o gris, con su icono) -->
    <style name="HQL.Text.Chip" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:background">@drawable/hql_chip</item>
        <item name="android:backgroundTint">@color/hql_surface_top</item>
        <item name="android:minHeight">32dp</item>
        <item name="android:paddingStart">8dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:paddingTop">6dp</item>
        <item name="android:paddingBottom">6dp</item>
        <item name="android:drawablePadding">8dp</item>
        <item name="android:gravity">center_vertical|start</item>
        <item name="android:textColor">@color/hql_text_dim</item>
        <item name="android:maxLines">3</item>
        <item name="android:ellipsize">end</item>
    </style>

    <!-- Etiqueta pequeña sobre fondo de acento (RECOMENDADO, COMPATIBLE) -->
    <!-- Etiqueta pequeña (Recomendado, Compatible): como una insignia de Material 3, en el contenedor del acento -->
    <style name="HQL.Text.Tag" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:background">@drawable/hql_tag</item>
        <item name="android:paddingStart">8dp</item>
        <item name="android:paddingEnd">8dp</item>
        <item name="android:paddingTop">2dp</item>
        <item name="android:paddingBottom">2dp</item>
        <item name="android:textColor">@color/hql_accent</item>
    </style>
</resources>
