<resources>
    <!-- Fondo y superficies, de más hundido a más elevado -->
    <color name="hql_bg">#0A0E14</color>
    <color name="hql_terminal">#06090D</color>
    <color name="hql_surface">#111821</color>
    <color name="hql_surface_hi">#17202B</color>
