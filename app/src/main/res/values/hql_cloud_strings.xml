    <!-- Phone: ⚙ › Car data (Leapmotor account) -->
    <string name="hql_cloud_menu">Car data (Leapmotor account)</string>
    <string name="hql_cloud_label">Leapmotor account · optional</string>
    <string name="hql_cloud_intro">HeadQLink can read your car’s status from the Leapmotor cloud with your account (battery, range, charging, tyre pressures, doors and odometer) and show it in the extended mode: the Status tab, and the real % in Route, Efficiency and Trips.\n\n• Read-only: it never sends commands to the car.\n• Unofficial API: it may stop working at any time.\n• Your data only goes to Leapmotor’s servers. The certificate and the session are stored encrypted on this phone; the password is not stored.\n• It needs the same client certificate as the LMB10 app.</string>
    <string name="hql_cloud_enabled">Use the real car data</string>
    <string name="hql_cloud_step_cert">1 · Client certificate</string>
    <string name="hql_cloud_cert_none">No certificate. Pick app.crt and app.key (together or one after the other), a .pem with both blocks or a .p12/.pfx.</string>
    <string name="hql_cloud_cert_ok">Certificate imported: %1$s</string>
    <string name="hql_cloud_cert_until">expires %1$s</string>
    <string name="hql_cloud_cert_import">Import certificate…</string>
    <string name="hql_cloud_cert_replace">Replace certificate…</string>
    <string name="hql_cloud_cert_password_title">Certificate password</string>
    <string name="hql_cloud_cert_password_hint">Password</string>
    <string name="hql_cloud_cert_saved">Certificate stored encrypted on this phone</string>
    <string name="hql_cloud_cert_err_needs_password">That file has a password.</string>
    <string name="hql_cloud_cert_err_wrong_password">Wrong password.</string>
    <string name="hql_cloud_cert_err_no_key">The private key is missing: pick the .key too (or a .pem with both).</string>
    <string name="hql_cloud_cert_err_no_cert">The certificate is missing: pick the .crt too (or a .pem with both).</string>
    <string name="hql_cloud_cert_err_mismatch">That key does not belong to that certificate.</string>
    <string name="hql_cloud_cert_err_encrypted">This encrypted key is not supported: use it without a password (openssl pkcs8 -topk8 -nocrypt) or as a .p12.</string>
    <string name="hql_cloud_cert_err_unreadable">Those files are not a certificate HeadQLink can read (PEM, DER or PKCS#12).</string>
    <string name="hql_cloud_cert_err_too_big">That file is too big to be a certificate.</string>
