<?xml version="1.0" encoding="utf-8"?>
<!-- El rayo aparece cuando el anillo está casi cerrado. -->
<objectAnimator xmlns:android="http://schemas.android.com/apk/res/android"
    android:duration="900">
    <propertyValuesHolder android:propertyName="fillAlpha">
        <keyframe
            android:fraction="0"
            android:value="0" />
        <keyframe
            android:fraction="0.45"
            android:value="0" />
        <keyframe
            android:fraction="0.7"
            android:value="1" />
        <keyframe
            android:fraction="1"
            android:value="1" />
    </propertyValuesHolder>
    <propertyValuesHolder android:propertyName="strokeAlpha">
        <keyframe
            android:fraction="0"
            android:value="0" />
        <keyframe
            android:fraction="0.45"
            android:value="0" />
        <keyframe
            android:fraction="0.7"
            android:value="1" />
        <keyframe
            android:fraction="1"
            android:value="1" />
    </propertyValuesHolder>
</objectAnimator>
