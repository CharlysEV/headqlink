<?xml version="1.0" encoding="utf-8"?>
<!--
    headqlink: widget «HeadQLink». 4x2 por defecto (targetCell* en Android 12+; minWidth/minHeight antes) y como mínimo
    2x2 (minResize*), redimensionable. Sin actualizaciones periódicas (updatePeriodMillis 0): lo repinta WidgetUpdater
    cuando cambia algo. La vista previa del selector es la propia disposición (Android 12+) o una imagen (antes).
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:description="@string/hql_w_description"
    android:initialLayout="@layout/hql_widget_wide"
    android:minWidth="250dp"
    android:minHeight="110dp"
    android:minResizeWidth="110dp"
    android:minResizeHeight="110dp"
    android:previewImage="@drawable/hql_widget_preview"
    android:previewLayout="@layout/hql_widget_wide"
    android:resizeMode="horizontal|vertical"
    android:targetCellWidth="4"
    android:targetCellHeight="2"
    android:updatePeriodMillis="0"
    android:widgetCategory="home_screen"
    tools:targetApi="31" />
