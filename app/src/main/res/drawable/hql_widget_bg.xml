<?xml version="1.0" encoding="utf-8"?>
<!-- Fondo del widget: la tarjeta «Eléctrico» (superficie con un filo de luz arriba), con las esquinas del sistema. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <corners android:radius="@dimen/hql_widget_radius" />
            <gradient
                android:angle="270"
                android:endColor="@color/hql_outline"
                android:startColor="@color/hql_edge" />
        </shape>
    </item>
    <item
        android:bottom="1dp"
        android:left="1dp"
        android:right="1dp"
        android:top="1dp">
        <shape>
            <corners android:radius="@dimen/hql_widget_radius" />
            <gradient
                android:angle="270"
                android:endColor="@color/hql_bg"
                android:startColor="@color/hql_surface" />
        </shape>
    </item>
</layer-list>
