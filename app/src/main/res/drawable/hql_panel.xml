<?xml version="1.0" encoding="utf-8"?>
<!-- Tarjeta: superficie con un filo de luz arriba que se apaga hacia abajo. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <corners android:radius="20dp" />
            <gradient
                android:angle="270"
                android:endColor="@color/hql_outline"
                android:startColor="@color/hql_edge" />
        </shape>
    </item>
    <item
        android:bottom="1dp"
        android:left="1dp"
        android:right="1dp"
        android:top="1dp">
        <shape>
            <corners android:radius="19dp" />
            <gradient
                android:angle="270"
                android:endColor="@color/hql_surface"
                android:startColor="#141C26" />
        </shape>
    </item>
</layer-list>
