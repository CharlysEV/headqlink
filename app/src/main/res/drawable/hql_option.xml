<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape>
            <solid android:color="@color/hql_surface_hi" />
            <stroke android:width="1.5dp" android:color="@color/hql_accent" />
            <corners android:radius="12dp" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="@color/hql_surface" />
            <stroke android:width="1dp" android:color="@color/hql_outline" />
            <corners android:radius="12dp" />
        </shape>
    </item>
</selector>
