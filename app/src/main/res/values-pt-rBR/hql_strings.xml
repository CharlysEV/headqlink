    <string name="hql_setup_accessibility_aa">Para receber os toques do carro e iniciar o Android Auto</string>
    <string name="hql_setup_accessibility_app">Para que os toques do carro cheguem ao app</string>
    <string name="hql_setup_app_body">O app abre em uma tela virtual que é enviada ao carro, por isso não aparece no celular. Os toques do carro chegam pelo serviço de acessibilidade.</string>
