<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="8dp"
    android:paddingEnd="24dp">

    <TextView
        style="@style/HQL.Text.Label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/hql_picture_profile" />

    <RadioGroup
        android:id="@+id/hql_v_profiles"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical" />

    <TextView
        android:id="@+id/hql_v_reason"
        style="@style/HQL.Text.Body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:alpha="0.7"
        android:textSize="12sp" />

    <!-- Fluidez: 30 fps (lo que pide el coche, menos calor) o 60 fps; solo con los perfiles Coche y Automático -->
    <TextView
        style="@style/HQL.Text.Label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/hql_fluidity" />

    <RadioGroup
        android:id="@+id/hql_v_fluidity"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <com.google.android.material.radiobutton.MaterialRadioButton
            android:id="@+id/hql_v_fluid_30"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/hql_fluidity_30" />

        <com.google.android.material.radiobutton.MaterialRadioButton
            android:id="@+id/hql_v_fluid_60"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/hql_fluidity_60" />
    </RadioGroup>

    <TextView
        style="@style/HQL.Text.Body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:alpha="0.7"
        android:text="@string/hql_fluidity_help"
        android:textSize="12sp" />

    <com.google.android.material.checkbox.MaterialCheckBox
        android:id="@+id/hql_v_autohide"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/hql_autohide_panel_ext" />

    <com.google.android.material.checkbox.MaterialCheckBox
        android:id="@+id/hql_v_keep_screen"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/hql_keep_screen_on" />

    <com.google.android.material.checkbox.MaterialCheckBox
        android:id="@+id/hql_v_car_mode"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/hql_android_car_mode" />

    <!-- Protección térmica: Normal / Suave / Apagada (ThermalPolicy); se aplica en el acto -->
    <TextView
        style="@style/HQL.Text.Label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/hql_thermal_mode" />

    <RadioGroup
        android:id="@+id/hql_v_thermal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <com.google.android.material.radiobutton.MaterialRadioButton
            android:id="@+id/hql_v_thermal_normal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/hql_thermal_normal" />

        <com.google.android.material.radiobutton.MaterialRadioButton
            android:id="@+id/hql_v_thermal_soft"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/hql_thermal_soft" />

        <com.google.android.material.radiobutton.MaterialRadioButton
            android:id="@+id/hql_v_thermal_off"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/hql_thermal_off" />
    </RadioGroup>

    <TextView
        style="@style/HQL.Text.Body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:alpha="0.7"
        android:text="@string/hql_thermal_help"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/hql_v_adv_toggle"
        style="@style/HQL.Text.Label.Accent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="?android:attr/selectableItemBackground"
        android:gravity="center_vertical"
        android:minHeight="48dp"
        android:text="@string/hql_advanced_closed" />

    <LinearLayout
        android:id="@+id/hql_v_advanced"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

    <TextView
        style="@style/HQL.Text.Body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/hql_advanced_help" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="horizontal">

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="fps">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/hql_v_fps"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="number" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:hint="kbps">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/hql_v_kbps"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="number" />
        </com.google.android.material.textfield.TextInputLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="@string/hql_width">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/hql_v_w"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="number" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:hint="@string/hql_height">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/hql_v_h"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="number" />
        </com.google.android.material.textfield.TextInputLayout>
    </LinearLayout>

    <TextView
        style="@style/HQL.Text.Label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/hql_h264_profile" />

    <RadioGroup
        android:id="@+id/hql_v_profile"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <com.google.android.material.radiobutton.MaterialRadioButton
            android:id="@+id/hql_v_baseline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Baseline" />

        <com.google.android.material.radiobutton.MaterialRadioButton
            android:id="@+id/hql_v_main"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Main" />

        <com.google.android.material.radiobutton.MaterialRadioButton
            android:id="@+id/hql_v_high"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="High" />
    </RadioGroup>

    <TextView
        style="@style/HQL.Text.Label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/hql_mode_aa" />

    <com.google.android.material.checkbox.MaterialCheckBox
        android:id="@+id/hql_v_lowlatency"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/hql_low_latency_profile" />

    <com.google.android.material.checkbox.MaterialCheckBox
        android:id="@+id/hql_v_brake"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/hql_brake" />

    <com.google.android.material.textfield.TextInputLayout
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/hql_brake_window">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/hql_v_window"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="number" />
    </com.google.android.material.textfield.TextInputLayout>

    <TextView
        style="@style/HQL.Text.Body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="8dp"
        android:text="@string/hql_brake_help" />

    <!-- qdauto: motor de protocolo -->
    <TextView
        style="@style/HQL.Text.Label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/hql_engine_title" />

    <RadioGroup
        android:id="@+id/hql_v_engine"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <com.google.android.material.radiobutton.MaterialRadioButton
            android:id="@+id/hql_v_engine_qdauto"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/hql_engine_qdauto" />

        <com.google.android.material.radiobutton.MaterialRadioButton
            android:id="@+id/hql_v_engine_original"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/hql_engine_original" />
    </RadioGroup>

    <TextView
        style="@style/HQL.Text.Body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="8dp"
        android:text="@string/hql_applies_on_reconnect" />

    <!-- Esperar al coche: tras perderlo, el enlace sigue escuchando y Android Auto en pausa este tiempo -->
    <TextView
        style="@style/HQL.Text.Label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/hql_car_wait_title" />

    <RadioGroup
        android:id="@+id/hql_v_car_wait"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical" />

    <TextView
        style="@style/HQL.Text.Body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="8dp"
        android:text="@string/hql_car_wait_help" />

    <!-- Arranque del servidor de Android Auto: automático (accesibilidad) o manual (sin accesibilidad) -->
    <LinearLayout
        android:id="@+id/hql_v_aa_server_box"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            style="@style/HQL.Text.Label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/hql_aa_server_start_title" />

        <RadioGroup
            android:id="@+id/hql_v_aa_server"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <com.google.android.material.radiobutton.MaterialRadioButton
                android:id="@+id/hql_v_aa_server_auto"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/hql_aa_server_start_auto" />

            <com.google.android.material.radiobutton.MaterialRadioButton
                android:id="@+id/hql_v_aa_server_manual"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/hql_aa_server_start_manual" />
        </RadioGroup>

        <TextView
            style="@style/HQL.Text.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="8dp"
            android:text="@string/hql_aa_server_start_help" />
    </LinearLayout>
    </LinearLayout>

    <TextView
        style="@style/HQL.Text.Body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:text="@string/hql_profile_reconnect_help" />
</LinearLayout>
