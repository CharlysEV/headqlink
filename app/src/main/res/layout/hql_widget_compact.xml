<?xml version="1.0" encoding="utf-8"?>
<!--
    headqlink: widget 2x2 (estilo «Eléctrico»): el botón grande, el estado y, arriba a la derecha, el icono de la conexión
    elegida (se toca para pasar a la siguiente). Solo vistas de RemoteViews; lo rellena LinkWidgetViews.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/hql_widget_bg"
    android:clipToOutline="true"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingStart="10dp"
    android:paddingTop="8dp"
    android:paddingEnd="10dp"
    android:paddingBottom="10dp"
    tools:targetApi="31">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- Coche virtual (probar sin coche) -->
        <ImageView
            android:id="@+id/hql_w_virtual"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/hql_w_cycle_bg"
            android:contentDescription="@string/hql_sim_menu"
            android:padding="8dp"
            android:scaleType="fitCenter"
            android:src="@drawable/hql_ln_car"
            android:tint="@color/hql_accent" />

        <!-- Separador (en RemoteViews no vale un View suelto) -->
        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <ImageView
            android:id="@+id/hql_w_link_cycle"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/hql_w_cycle_bg"
            android:padding="8dp"
            android:scaleType="fitCenter"
            android:src="@drawable/hql_w_link_hotspot"
            android:tint="@color/hql_accent" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/hql_w_power"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@drawable/hql_w_press"
        android:padding="2dp">

        <ImageView
            android:id="@+id/hql_w_power_icon"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:adjustViewBounds="true"
            android:importantForAccessibility="no"
            android:maxWidth="100dp"
            android:maxHeight="100dp"
            android:scaleType="fitCenter"
            android:src="@drawable/hql_w_power_off" />
    </FrameLayout>

    <TextView
        android:id="@+id/hql_w_title"
        style="@style/HQL.Widget.Title"
        android:layout_marginTop="6dp"
        android:gravity="center"
        android:maxLines="2"
        android:text="@string/hql_w_off"
        android:textSize="15sp" />

    <TextView
        android:id="@+id/hql_w_detail"
        style="@style/HQL.Widget.Detail"
        android:gravity="center"
        android:text="@string/hql_w_tap_to_connect"
        android:textSize="12sp" />
</LinearLayout>
