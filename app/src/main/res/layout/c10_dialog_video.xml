<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="8dp"
    android:paddingEnd="24dp">

    <TextView
        style="@style/C10.Text.Body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Vacío = lo que pida el coche. En Android Auto la resolución la negocia AA." />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="horizontal">

        <EditText
            android:id="@+id/c10_v_fps"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="fps"
            android:inputType="number" />

        <EditText
            android:id="@+id/c10_v_kbps"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:hint="kbps"
            android:inputType="number" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <EditText
            android:id="@+id/c10_v_w"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="ancho"
            android:inputType="number" />

        <EditText
            android:id="@+id/c10_v_h"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:hint="alto"
            android:inputType="number" />
    </LinearLayout>

    <TextView
        style="@style/C10.Text.Label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Perfil H.264" />

    <RadioGroup
        android:id="@+id/c10_v_profile"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <RadioButton
            android:id="@+id/c10_v_baseline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Baseline" />

        <RadioButton
            android:id="@+id/c10_v_main"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Main" />

        <RadioButton
            android:id="@+id/c10_v_high"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="High" />
    </RadioGroup>

    <TextView
        style="@style/C10.Text.Label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Android Auto" />

    <CheckBox
        android:id="@+id/c10_v_reencode"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Último frame: recodificar en el móvil (recomendado)" />

    <CheckBox
        android:id="@+id/c10_v_brake"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Frenar a Android Auto al ritmo del coche (recomendado)" />

    <EditText
        android:id="@+id/c10_v_window"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="frames en camino con el freno (2)"
        android:inputType="number" />

    <TextView
        style="@style/C10.Text.Body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="8dp"
        android:text="Se aplican al volver a conectar: Desconectar y Conectar. Con «último frame» el freno no se usa." />
</LinearLayout>
