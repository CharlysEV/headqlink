<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView
        android:id="@+id/hql_check_title"
        style="@style/HQL.Text.Title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <TextView
        android:id="@+id/hql_check_body"
        style="@style/HQL.Text.Body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp" />

    <LinearLayout
        android:id="@+id/hql_check_list"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="22dp"
        android:background="@drawable/hql_panel"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingEnd="12dp" />

    <TextView
        android:id="@+id/hql_check_guide_label"
        style="@style/HQL.Text.Label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="26dp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/hql_check_guide"
        style="@style/HQL.Text.Body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/hql_panel"
        android:padding="18dp"
        android:visibility="gone" />
</LinearLayout>
