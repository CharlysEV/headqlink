<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView
        android:id="@+id/hql_check_title"
        style="@style/HQL.Text.Title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <TextView
        android:id="@+id/hql_check_body"
        style="@style/HQL.Text.Body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp" />

    <!-- Resumen de la comprobación («Todo listo» / «Faltan N cosas»); en la pantalla «Comprobación» va en el título. -->
    <TextView
        android:id="@+id/hql_check_summary"
        style="@style/HQL.Text.RowTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:fontFamily="sans-serif-medium"
        android:textSize="18sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/hql_check_summary_detail"
        style="@style/HQL.Text.RowDetail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/hql_check_list"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="22dp"
        android:background="@drawable/hql_panel"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingEnd="12dp" />

    <TextView
        android:id="@+id/hql_check_guide_label"
        style="@style/HQL.Text.Label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="26dp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/hql_check_guide"
        style="@style/HQL.Text.Body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/hql_panel"
        android:padding="18dp"
        android:visibility="gone" />
</LinearLayout>
