<?xml version="1.0" encoding="utf-8"?>
<!-- headqlink: pantalla principal. Cabecera con la marca, tarjeta del modo, tarjeta de estado (panel en directo de
     fps y Mbps y una fila por cosa con su chip de color) y el botón CONECTAR. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="12dp"
        android:paddingEnd="20dp"
        android:paddingBottom="22dp">

        <!-- Cabecera -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:importantForAccessibility="no"
                android:src="@drawable/hql_logo" />

            <TextView
                style="@style/HQL.Text.Brand"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:text="HeadQLink" />

            <ImageButton
                android:id="@+id/hql_home_menu"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:background="@drawable/hql_icon_btn"
                android:contentDescription="@string/hql_settings"
                android:padding="14dp"
                android:scaleType="fitCenter"
                android:src="@drawable/hql_ln_gear"
                android:tint="@color/hql_text" />
        </LinearLayout>

        <!-- Modo y conexión -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="@drawable/hql_panel"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="14dp"
            android:paddingEnd="8dp"
            android:paddingBottom="6dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/hql_home_mode"
                    style="@style/HQL.Text.Title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textSize="24sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/hql_home_change"
                    style="@style/HQL.Button.Quiet"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="@string/hql_change" />
            </LinearLayout>

            <TextView
                android:id="@+id/hql_home_mode_detail"
                style="@style/HQL.Text.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:paddingEnd="12dp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="14dp"
                android:layout_marginEnd="12dp"
                android:background="@color/hql_outline" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/hql_home_bt_auto"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:drawableStart="@drawable/hql_ln_bt"
                android:drawablePadding="14dp"
                android:drawableTint="@color/hql_accent"
                android:minHeight="60dp"
                android:paddingEnd="12dp"
                android:text="@string/hql_bt_auto_switch"
                android:textColor="@color/hql_text"
                android:textSize="15sp" />
        </LinearLayout>

        <!-- Estado -->
        <TextView
            style="@style/HQL.Text.Label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginTop="24dp"
            android:text="@string/hql_status_title" />

        <LinearLayout
            android:id="@+id/hql_home_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/hql_panel_glow"
            android:elevation="8dp"
            android:orientation="vertical"
            android:outlineAmbientShadowColor="@color/hql_accent"
            android:outlineSpotShadowColor="@color/hql_accent"
            android:paddingStart="18dp"
            android:paddingTop="16dp"
            android:paddingEnd="14dp"
            android:paddingBottom="6dp">

            <!-- En directo: fps y Mbps del vídeo al coche -->
            <LinearLayout
                android:id="@+id/hql_home_live"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:focusable="true"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <View
                        android:id="@+id/hql_home_live_dot"
                        android:layout_width="8dp"
                        android:layout_height="8dp"
                        android:background="@drawable/hql_dot" />

                    <TextView
                        style="@style/HQL.Text.Label.Accent"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="@string/hql_live" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/hql_meter_fps_value"
                                style="@style/HQL.Text.Meter"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="—" />

                            <TextView
                                style="@style/HQL.Text.Unit"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="6dp"
                                android:text="fps" />
                        </LinearLayout>

                        <com.headqlink.link.MeterView
                            android:id="@+id/hql_meter_fps"
                            android:layout_width="match_parent"
                            android:layout_height="20dp"
                            android:layout_marginTop="8dp"
                            android:layout_marginEnd="16dp" />
                    </LinearLayout>

                    <View
                        android:layout_width="1dp"
                        android:layout_height="match_parent"
                        android:layout_marginTop="4dp"
                        android:layout_marginBottom="2dp"
                        android:background="@color/hql_outline" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:paddingStart="16dp">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/hql_meter_mbps_value"
                                style="@style/HQL.Text.Meter"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="—" />

                            <TextView
                                style="@style/HQL.Text.Unit"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="6dp"
                                android:text="Mbps" />
                        </LinearLayout>

                        <com.headqlink.link.MeterView
                            android:id="@+id/hql_meter_mbps"
                            android:layout_width="match_parent"
                            android:layout_height="20dp"
                            android:layout_marginTop="8dp"
                            android:layout_marginEnd="4dp" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="16dp"
                android:background="@color/hql_outline" />

            <LinearLayout
                android:id="@+id/hql_home_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </LinearLayout>

        <TextView
            android:id="@+id/hql_home_hint"
            style="@style/HQL.Text.RowDetail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="4dp"
            android:textSize="14sp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:minHeight="24dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/hql_home_toggle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:elevation="10dp"
            android:minHeight="66dp"
            android:outlineAmbientShadowColor="@color/hql_accent"
            android:outlineSpotShadowColor="@color/hql_accent"
            android:textSize="19sp" />
    </LinearLayout>
</ScrollView>
