<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="28dp"
        android:paddingTop="20dp"
        android:paddingEnd="28dp"
        android:paddingBottom="24dp">

        <TextView
            style="@style/C10.Text.Label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="C10Link" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/c10_home_mode"
                style="@style/C10.Text.Title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/c10_home_change"
                style="@style/C10.Button.Quiet"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Cambiar" />
        </LinearLayout>

        <TextView
            android:id="@+id/c10_home_mode_detail"
            style="@style/C10.Text.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp" />

        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/c10_home_aa_variant"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            app:selectionRequired="true"
            app:singleSelection="true">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/c10_home_aa_plain"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Android Auto" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/c10_home_aa_ext"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Ampliado" />
        </com.google.android.material.button.MaterialButtonToggleGroup>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/c10_home_panel_color"
            style="@style/C10.Button.Quiet"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Color del panel" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/c10_home_tv_list"
            style="@style/C10.Button.Quiet"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Lista de TV" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/c10_home_pdfs"
            style="@style/C10.Button.Quiet"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Documentos PDF" />

        <LinearLayout
            android:id="@+id/c10_home_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="@drawable/c10_panel"
            android:orientation="vertical"
            android:paddingStart="18dp"
            android:paddingTop="6dp"
            android:paddingEnd="18dp"
            android:paddingBottom="6dp" />

        <TextView
            android:id="@+id/c10_home_hint"
            style="@style/C10.Text.RowDetail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:minHeight="24dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/c10_home_toggle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/c10_home_video"
                style="@style/C10.Button.Quiet"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ajustes de imagen" />

            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/c10_home_log"
                style="@style/C10.Button.Quiet"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Diagnóstico" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
