<?xml version="1.0" encoding="utf-8"?>
<!-- qdauto: opciones de prueba del motor QDAuto (claves del Anexo A sin ajuste propio), en Diagnóstico. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="8dp"
    android:paddingEnd="24dp">

    <TextView
        style="@style/HQL.Text.Body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="8dp"
        android:text="@string/hql_qd_options_help" />

    <com.google.android.material.checkbox.MaterialCheckBox
        android:id="@+id/hql_qd_keep_video"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/hql_qd_keep_video" />

    <com.google.android.material.checkbox.MaterialCheckBox
        android:id="@+id/hql_qd_supersede"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/hql_qd_supersede" />

    <com.google.android.material.checkbox.MaterialCheckBox
        android:id="@+id/hql_qd_peer_strict"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/hql_qd_peer_strict" />

    <com.google.android.material.checkbox.MaterialCheckBox
        android:id="@+id/hql_qd_phone_info"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/hql_qd_phone_info_qdlink" />

    <!-- headqlink: prueba de la trama del cable USB desde el PC (qdsim con la opción usb-framing) -->
    <com.google.android.material.checkbox.MaterialCheckBox
        android:id="@+id/hql_qd_usb_over_tcp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/hql_qd_usb_over_tcp" />

    <TextView
        style="@style/HQL.Text.Label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/hql_qd_car_gone" />

    <com.google.android.material.textfield.TextInputLayout
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="30">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/hql_qd_car_gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:importantForAutofill="no"
            android:inputType="number" />
    </com.google.android.material.textfield.TextInputLayout>

    <TextView
        style="@style/HQL.Text.Body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="8dp"
        android:text="@string/hql_applies_on_reconnect" />
</LinearLayout>
