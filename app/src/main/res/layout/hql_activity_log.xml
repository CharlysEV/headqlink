<?xml version="1.0" encoding="utf-8"?>
<!-- El FrameLayout aplica los insets del sistema; el contenido interior conserva su margen lateral. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- En vertical no cabe con los dos botones: el título se encoge antes que partirse en dos líneas. -->
            <androidx.appcompat.widget.AppCompatTextView
                style="@style/HQL.Text.Title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:maxLines="1"
                android:text="@string/hql_diagnostics"
                android:textSize="24sp"
                app:autoSizeMaxTextSize="24sp"
                app:autoSizeMinTextSize="14sp"
                app:autoSizeTextType="uniform" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/hql_log_latency"
                style="@style/HQL.Button.Quiet"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="4dp"
                android:text="@string/hql_measure_latency" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/hql_log_copy"
                style="@style/HQL.Button.Quiet"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="-12dp"
                android:text="@string/hql_copy" />
        </LinearLayout>

        <!-- qdauto: exportar el log completo y prueba con patrón -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/hql_panel"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingTop="8dp"
            android:paddingEnd="10dp"
            android:paddingBottom="8dp">

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/hql_log_pattern"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minHeight="52dp"
                android:text="@string/hql_pattern_test"
                android:textColor="@color/hql_text"
                android:textSize="15sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/hql_log_export"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:minHeight="50dp"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:text="@string/hql_export_log"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- headqlink: opciones de prueba del motor y vista previa del modo extendido (sin coche) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/hql_log_qd_options"
                style="@style/HQL.Button.Quiet"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="-12dp"
                android:text="@string/hql_qd_test_options" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/hql_log_preview"
                style="@style/HQL.Button.Quiet"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/hql_preview_title" />

            <!-- headqlink: las últimas sesiones con el coche, resumidas (sessions.csv) -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/hql_log_sessions"
                style="@style/HQL.Button.Quiet"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/hql_sessions_button" />
        </LinearLayout>

        <TextView
            android:id="@+id/hql_log_info"
            style="@style/HQL.Text.RowDetail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/hql_log_file"
            style="@style/HQL.Text.RowDetail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textIsSelectable="true"
            android:textSize="12sp" />

        <ScrollView
            android:id="@+id/hql_log_scroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="16dp"
            android:layout_weight="1"
            android:background="@drawable/hql_terminal"
            android:padding="14dp">

            <TextView
                android:id="@+id/hql_log_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:lineSpacingExtra="1dp"
                android:textColor="@color/hql_log_text"
                android:textIsSelectable="true"
                android:textSize="10.5sp" />
        </ScrollView>
    </LinearLayout>
</FrameLayout>
