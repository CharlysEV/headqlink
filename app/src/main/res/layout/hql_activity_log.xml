<?xml version="1.0" encoding="utf-8"?>
<!-- El FrameLayout aplica los insets del sistema; el contenido interior conserva su margen lateral. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="28dp"
        android:paddingEnd="28dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                style="@style/HQL.Text.Title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/hql_diagnostics"
                android:textSize="22sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/hql_log_latency"
                style="@style/HQL.Button.Quiet"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="16dp"
                android:text="@string/hql_measure_latency" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/hql_log_copy"
                style="@style/HQL.Button.Quiet"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/hql_copy" />
        </LinearLayout>

        <!-- qdauto: exportar el log completo y prueba con patrón -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/hql_log_pattern"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/hql_pattern_test" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/hql_log_export"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="@string/hql_export_log" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/hql_log_qd_options"
            style="@style/HQL.Button.Quiet"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/hql_qd_test_options" />

        <TextView
            android:id="@+id/hql_log_info"
            style="@style/HQL.Text.RowDetail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/hql_log_file"
            style="@style/HQL.Text.RowDetail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textIsSelectable="true"
            android:textSize="12sp" />

        <ScrollView
            android:id="@+id/hql_log_scroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="16dp"
            android:layout_weight="1"
            android:background="@drawable/hql_panel"
            android:padding="12dp">

            <TextView
                android:id="@+id/hql_log_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:textColor="@color/hql_text_dim"
                android:textIsSelectable="true"
                android:textSize="10.5sp" />
        </ScrollView>
    </LinearLayout>
</FrameLayout>
