<?xml version="1.0" encoding="utf-8"?>
<!-- headqlink: ⚙ › «Datos del coche (cuenta Leapmotor)» (CarCloudActivity). Solo lectura. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <!--
            Enfocable: así, al abrir, el foco no va al «Correo» (sin teclado ni sugerencias de autorrelleno que tapen el
            botón del certificado, justo encima).
        -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="16dp"
            android:paddingEnd="20dp"
            android:paddingBottom="28dp">

            <TextView
                style="@style/HQL.Text.Label.Accent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/hql_cloud_label" />

            <TextView
                style="@style/HQL.Text.Title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/hql_cloud_menu"
                android:textSize="24sp" />

            <!-- Qué es, qué no hace y la privacidad -->
            <TextView
                android:id="@+id/hql_cloud_intro"
                style="@style/HQL.Text.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/hql_panel"
                android:padding="16dp"
                android:text="@string/hql_cloud_intro" />

            <TextView
                android:id="@+id/hql_cloud_unsupported"
                style="@style/HQL.Text.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/hql_cloud_unsupported_phone"
                android:textColor="@color/hql_warn"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/hql_cloud_body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/hql_cloud_enabled"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/hql_panel"
                    android:minHeight="56dp"
                    android:paddingStart="16dp"
                    android:paddingEnd="12dp"
                    android:text="@string/hql_cloud_enabled"
                    android:textColor="@color/hql_text"
                    android:textSize="15sp" />

                <!-- 1 · Certificado -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/hql_panel"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        style="@style/HQL.Text.Label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/hql_cloud_step_cert" />

                    <TextView
                        android:id="@+id/hql_cloud_cert_state"
                        style="@style/HQL.Text.RowDetail"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="@string/hql_cloud_cert_none" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/hql_cloud_cert_import"
                        style="@style/HQL.Button.Outline"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/hql_cloud_cert_import" />

                    <!-- Con el .crt o el .key elegido a medias: olvidarlo y volver a empezar -->
                    <TextView
                        android:id="@+id/hql_cloud_cert_restart"
                        style="@style/HQL.Text.RowDetail"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="?attr/selectableItemBackground"
                        android:minHeight="48dp"
                        android:gravity="center_vertical"
                        android:paddingEnd="12dp"
                        android:text="@string/hql_cloud_cert_restart"
                        android:textColor="@color/hql_accent"
                        android:visibility="gone" />
                </LinearLayout>

                <!-- 2 · Cuenta -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/hql_panel"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        style="@style/HQL.Text.Label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/hql_cloud_step_account" />

                    <LinearLayout
                        android:id="@+id/hql_cloud_login_box"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:hint="@string/hql_cloud_email">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/hql_cloud_email"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:autofillHints="emailAddress"
                                android:importantForAutofill="yes"
                                android:inputType="textEmailAddress"
                                android:maxLines="1" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:hint="@string/hql_cloud_password"
                            app:endIconMode="password_toggle">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/hql_cloud_password"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:autofillHints="password"
                                android:importantForAutofill="yes"
                                android:inputType="textPassword"
                                android:maxLines="1" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <TextView
                            style="@style/HQL.Text.RowDetail"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="@string/hql_cloud_password_note"
                            android:textColor="@color/hql_text_faint" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/hql_cloud_login"
                            style="@style/HQL.Button.Outline"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="@string/hql_cloud_login" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/hql_cloud_session_box"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:visibility="gone">

                        <TextView
                            android:id="@+id/hql_cloud_session"
                            style="@style/HQL.Text.RowTitle"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/hql_cloud_logout"
                            style="@style/HQL.Button.Quiet"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="-8dp"
                            android:text="@string/hql_cloud_logout" />
                    </LinearLayout>
                </LinearLayout>

                <!-- 3 · Coche -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/hql_panel"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/HQL.Text.Label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/hql_cloud_step_car" />

                        <TextView
                            android:id="@+id/hql_cloud_car"
                            style="@style/HQL.Text.RowTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:text="@string/hql_cloud_car_none" />
                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/hql_cloud_choose_car"
                        style="@style/HQL.Button.Quiet"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="-8dp"
                        android:text="@string/hql_cloud_choose_car" />
                </LinearLayout>

                <!-- 4 · Batería (variante) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/hql_panel"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        style="@style/HQL.Text.Label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/hql_cloud_step_battery" />

                    <TextView
                        android:id="@+id/hql_cloud_battery_note"
                        style="@style/HQL.Text.RowDetail"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="@string/hql_cloud_battery_note" />

                    <RadioGroup
                        android:id="@+id/hql_cloud_profile"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp">

                        <com.google.android.material.radiobutton.MaterialRadioButton
                            android:id="@+id/hql_cloud_profile_life"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:minHeight="48dp"
                            android:text="@string/hql_cloud_profile_life"
                            android:textColor="@color/hql_text" />

                        <com.google.android.material.radiobutton.MaterialRadioButton
                            android:id="@+id/hql_cloud_profile_promax"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:minHeight="48dp"
                            android:text="@string/hql_cloud_profile_promax"
                            android:textColor="@color/hql_text" />

                        <com.google.android.material.radiobutton.MaterialRadioButton
                            android:id="@+id/hql_cloud_profile_reev"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:minHeight="48dp"
                            android:text="@string/hql_cloud_profile_reev"
                            android:textColor="@color/hql_text" />

                        <com.google.android.material.radiobutton.MaterialRadioButton
                            android:id="@+id/hql_cloud_profile_custom"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:minHeight="48dp"
                            android:text="@string/hql_cloud_profile_custom_none"
                            android:textColor="@color/hql_text" />
                    </RadioGroup>
                </LinearLayout>

                <!-- 5 · Modo centinela (opcional: la única orden al coche, solo con el PIN guardado) -->
                <LinearLayout
                    android:id="@+id/hql_cloud_sentry_box"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/hql_panel"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        style="@style/HQL.Text.Label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/hql_cloud_step_sentry" />

                    <TextView
                        android:id="@+id/hql_cloud_sentry_state"
                        style="@style/HQL.Text.RowTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp" />

                    <TextView
                        style="@style/HQL.Text.RowDetail"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/hql_cloud_sentry_note" />

                    <LinearLayout
                        android:id="@+id/hql_cloud_pin_box"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:hint="@string/hql_cloud_pin_hint">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/hql_cloud_pin"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:importantForAutofill="no"
                                android:inputType="numberPassword"
                                android:maxLength="12" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/hql_cloud_pin_save"
                            style="@style/HQL.Button.Quiet"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:text="@string/hql_cloud_pin_save" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/hql_cloud_sentry_actions"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/hql_cloud_sentry_on"
                            style="@style/HQL.Button"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/hql_cloud_sentry_on" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/hql_cloud_sentry_off"
                            style="@style/HQL.Button.Quiet"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:text="@string/hql_cloud_sentry_off" />

                        <View
                            android:layout_width="0dp"
                            android:layout_height="1dp"
                            android:layout_weight="1" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/hql_cloud_pin_forget"
                            style="@style/HQL.Button.Quiet"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="-8dp"
                            android:text="@string/hql_cloud_pin_forget" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Prueba -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/hql_cloud_test"
                    style="@style/HQL.Button"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/hql_cloud_test" />

                <TextView
                    android:id="@+id/hql_cloud_result"
                    style="@style/HQL.Text.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/hql_panel"
                    android:fontFeatureSettings="tnum"
                    android:padding="16dp"
                    android:textColor="@color/hql_text"
                    android:textIsSelectable="true"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/hql_cloud_status"
                    style="@style/HQL.Text.RowDetail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:visibility="gone" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/hql_cloud_wipe"
                    style="@style/HQL.Button.Quiet"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="-12dp"
                    android:layout_marginTop="16dp"
                    android:text="@string/hql_cloud_wipe"
                    android:textColor="@color/hql_error" />
            </LinearLayout>

            <TextView
                style="@style/HQL.Text.RowDetail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/hql_cloud_credits"
                android:textColor="@color/hql_text_faint" />
        </LinearLayout>
    </ScrollView>
</FrameLayout>
