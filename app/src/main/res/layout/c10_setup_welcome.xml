<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView
        style="@style/C10.Text.Label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="C10Link" />

    <TextView
        style="@style/C10.Text.Title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Tu móvil, en la pantalla del C10" />

    <TextView
        style="@style/C10.Text.Body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="C10Link usa la conexión QDLink del coche para llevar a su pantalla Android Auto o la app que elijas. El móvil puede ir bloqueado y con la pantalla apagada." />

    <TextView
        style="@style/C10.Text.Label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:text="Antes de empezar" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@drawable/c10_panel"
        android:orientation="vertical"
        android:padding="18dp">

        <TextView
            style="@style/C10.Text.RowTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Haz la configuración con el coche aparcado" />

        <TextView
            style="@style/C10.Text.RowDetail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Y nunca manipules el móvil mientras conduces." />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="14dp"
            android:background="@color/c10_outline" />

        <TextView
            style="@style/C10.Text.RowTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="QDLink visible en la pantalla del coche" />

        <TextView
            style="@style/C10.Text.RowDetail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="El móvil y el coche se conectan por WiFi Direct; no hace falta cable." />
    </LinearLayout>
</LinearLayout>
