<?xml version="1.0" encoding="utf-8"?>
<!-- El FrameLayout aplica los insets del sistema; el contenido interior conserva su margen lateral. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="28dp"
        android:paddingEnd="28dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                style="@style/C10.Text.Title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Diagnóstico"
                android:textSize="22sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/c10_log_latency"
                style="@style/C10.Button.Quiet"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="16dp"
                android:text="Medir latencia" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/c10_log_copy"
                style="@style/C10.Button.Quiet"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Copiar" />
        </LinearLayout>

        <TextView
            android:id="@+id/c10_log_file"
            style="@style/C10.Text.RowDetail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textIsSelectable="true"
            android:textSize="12sp" />

        <ScrollView
            android:id="@+id/c10_log_scroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="16dp"
            android:layout_weight="1"
            android:background="@drawable/c10_panel"
            android:padding="12dp">

            <TextView
                android:id="@+id/c10_log_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:textColor="@color/c10_text_dim"
                android:textIsSelectable="true"
                android:textSize="10.5sp" />
        </ScrollView>
    </LinearLayout>
</FrameLayout>
